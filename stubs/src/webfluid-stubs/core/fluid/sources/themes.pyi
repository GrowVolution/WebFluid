
from fastapi import Request
from markupsafe import Markup

from webfluid import Fluid

_SURFACES: Markup

class Themes:
    fluid: Fluid
    themes: dict[str, Markup]
    global_theme: str
    def __init__(self, fluid: Fluid) -> None: ...
    def _validate(self, name: str, exists: bool) -> None: ...
    def _selected(self, name: str | None = None) -> Markup: ...
    def _read(self, markup: Markup, scheme: str | None) -> dict[str, str]: ...
    def add(self, name: str, link: Markup | str) -> None: ...
    def get(self) -> Markup: ...
    def set(self, request: Request, name: str) -> None: ...
    def variables(self, name: str | None = None, scheme: str | None = None) -> dict[str, str]: ...
