import asyncio
from collections.abc import Awaitable, Callable
from typing import Any, Optional

from babel.support import Translations
from sqlalchemy.orm import Mapped

async def _retry_locked(
    fn: Callable[[], Awaitable[Any]], *, attempts: int = 6, delay: float = 0.1
) -> Any: ...
def _plural_rule(locale: str) -> Callable[[int], str]: ...
def _plural_form(locale: str, num: int) -> str: ...

class I18nKey:
    id: Mapped[int]
    key: Mapped[str]
    domain: Mapped[str]
    cached: Mapped[bool]
    messages: Mapped[list[I18nMessage]]
    def __init__(self, key: str, domain: str, cached: bool = True) -> None: ...

class I18nMessage:
    id: Mapped[int]
    kid: Mapped[int]
    locale: Mapped[str]
    pf: Mapped[str]
    text: Mapped[str]
    ctx: Mapped[Optional[str]]
    key: Mapped[I18nKey]
    def __init__(
        self, kid: int, locale: str, text: str, pf: str = "one", ctx: str | None = None
    ) -> None: ...

class MergedTranslations(Translations):
    _locks: dict[str, dict[str, asyncio.Lock]]
    _db_cache: dict[str, dict[str, dict[str, Any]]]
    _uncached: dict[str, set[str]]
    def __init__(self, wrapped: Translations, locale: str, domain: str) -> None: ...
    def _db_fetch(self, key: str, num: int = 1, ctx: str | None = None) -> str | None: ...
    def _db_get(self, key: str, num: int = 1, ctx: str | None = None) -> str | None: ...
    def _mo_get(self, message: str) -> str: ...
    def _mo_nget(self, singular: str, plural: str, n: int) -> str: ...
    def _mo_pget(self, context: str, message: str) -> str | object: ...
    def _mo_pnget(self, context: str, singular: str, plural: str, num: int) -> str: ...
    def gettext(self, message: str) -> str: ...
    def ngettext(self, singular: str, plural: str, n: int) -> str: ...
    def pgettext(self, context: str, message: str) -> str | object: ...
    def npgettext(self, context: str, singular: str, plural: str, num: int) -> str: ...
    async def settext(self, key: str, message: str) -> None: ...
    async def nsettext(self, key: str, message: str, pf: str) -> None: ...
    async def psettext(self, key: str, message: str, context: str) -> None: ...
    async def npsettext(self, key: str, message: str, pf: str, context: str) -> None: ...
    async def uncache(self, key: str) -> None: ...
    async def recache(self, key: str) -> None: ...
    @classmethod
    async def _kid(cls, domain: str, key: str) -> int: ...
    @classmethod
    async def _resolve_keys(cls, domain: str, keys: set[str]) -> dict[str, int]: ...
    @classmethod
    async def _set(
        cls, locale: str, domain: str, key: str, message: str, pf: str, ctx: str | None
    ) -> None: ...
    @classmethod
    def _ensure_cache_and_lock(cls, locale: str, domain: str) -> asyncio.Lock: ...
    @classmethod
    def cache(cls, locale: str) -> dict[str, Any] | None: ...
    @classmethod
    async def db_load(cls, locale: str, domain: str) -> None: ...
    @classmethod
    async def update(
        cls,
        domain: str,
        translations: Callable[
            [], dict[str, dict[str, dict[tuple[str, str | None], str]]]
        ],
    ) -> None: ...
