import subprocess
from pathlib import Path
from typing import Any, Callable, TypeVar

from webfluid.cli.run.output import LogService

_F = TypeVar("_F", bound=Callable[..., Any])

def _require_log_service(fn: _F) -> _F: ...

class Lifecycle:
    _env: dict[str, str]
    _project_root: Path
    _log_service: LogService | None
    proc: subprocess.Popen[bytes] | None
    terminate: bool
    def __init__(self, env: dict[str, str], project_root: Path) -> None: ...
    def attach_log_service(self, log_service: LogService) -> None: ...
    def exit(self, signum: int, _: object) -> None: ...
    def restart(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    @property
    def status(self) -> str: ...
