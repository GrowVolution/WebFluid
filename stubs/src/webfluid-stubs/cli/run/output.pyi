from pathlib import Path
from typing import IO, TYPE_CHECKING

if TYPE_CHECKING:
    from webfluid.cli.run.lifecycle import Lifecycle

class LogService:
    streaming: bool
    log_dir: Path
    log_file: Path
    log: IO[str] | None
    def __init__(self, app_name: str) -> None: ...
    def __enter__(self) -> LogService: ...
    def __exit__(self, *args: object) -> bool: ...
    def _stream_log(self, lifecycle: "Lifecycle") -> None: ...
    def start_stream(self, lifecycle: "Lifecycle") -> None: ...
    def join_log(self, lifecycle: "Lifecycle") -> None: ...
    def clear_logs(self, lifecycle: "Lifecycle") -> None: ...
