from typing import Any

from redis import Redis as SyncRedis
from redis.asyncio import Redis as AsyncRedis

from webfluid import Fluid
from webfluid.extensions.cache.base import BaseCache

class RedisCache(BaseCache):
    _redis_uri: str
    _sync: SyncRedis | None
    _async: AsyncRedis | None
    def __init__(self, fluid: Fluid | None = None) -> None: ...
    def expand_fluid(self, fluid: Fluid, *args: Any, **kwargs: Any) -> None: ...
    @property
    def cache(self) -> SyncRedis: ...
    @property
    def acache(self) -> AsyncRedis: ...
    def set(self, key: str, value: Any, timeout: int | None = None) -> None: ...
    def get(self, key: str) -> Any: ...
    def delete(self, key: str) -> None: ...
    def clear(self) -> None: ...
    async def aset(self, key: str, value: Any, timeout: int | None = None) -> None: ...
    async def aget(self, key: str) -> Any: ...
    async def adelete(self, key: str) -> None: ...
    async def aclear(self) -> None: ...
