from typing import Any

from webfluid import Fluid
from webfluid.extensions.base import FluidExtension

class BaseCache(FluidExtension):
    _default_timeout: int
    def __init__(self, fluid: Fluid | None = None) -> None: ...
    def expand_fluid(self, fluid: Fluid, *_: Any, **__: Any) -> None: ...
    def set(self, key: str, value: Any, timeout: int | None = None) -> None: ...
    def get(self, key: str) -> Any: ...
    def delete(self, key: str) -> None: ...
    def clear(self) -> None: ...
    async def aset(self, key: str, value: Any, timeout: int | None = None) -> None: ...
    async def aget(self, key: str) -> Any: ...
    async def adelete(self, key: str) -> None: ...
    async def aclear(self) -> None: ...
